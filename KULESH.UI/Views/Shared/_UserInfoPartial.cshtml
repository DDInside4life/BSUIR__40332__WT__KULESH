@using Microsoft.AspNetCore.Identity
@using KULESH.UI.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!-- Информация пользователя -->
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var displayName = user?.UserName ?? User.Identity?.Name ?? "User";

    <div class="dropdown ms-auto nav-color">
        <button class="btn btn-secondary dropdown-toggle"
                type="button" id="dropdownMenuButton"
                data-bs-toggle="dropdown"
                aria-expanded="false">
            @displayName
            <img src="images/default-profile-picture.png" width="30"
                 alt="User" class="rounded nav-color" />
        </button>
        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
            <li>
                <span class="dropdown-item-text">
                    <img src="images/default-profile-picture.png"
                         width="50" alt="User" class="rounded" />
                    @displayName
                </span>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form id="logoutForm" class="form-inline"
                      asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnurl="/">
                    <button id="logout" type="submit" class="nav-link btn btn-link text-dark">
                        Выйти
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="ms-auto">
        <a class="nav-link text-dark d-inline" asp-area="Identity" asp-page="/Account/Register">Зарегистрироваться</a>
        <a class="nav-link text-dark d-inline" asp-area="Identity" asp-page="/Account/Login">Войти</a>
    </div>
}
<!-- Информация пользователя - конец -->
